# Leave blank to inspect the UI. Workflows use your own ComfyUI; video APIs use your own key.
CHENYU_CARD_URL=
# Baidu SD2 / SD2.5: server-side VOD v3 API key; never put it in public files.
# An existing private/baidu-video.json may supply the same api_key locally.
BAIDU_VOD_API_KEY=
HOST=127.0.0.1
PORT=8770
# Direct loopback requests open the local workspace without login by default.
# Set to 0 to test account login locally; external requests still require login.
# Railway disables local mode regardless of this setting.
YINGXU_LOCAL_MODE=1
# Optional: use an absolute path to move persistent uploads, outputs and SQLite.
YINGXU_DATA_DIR=
# Optional: use your own API graphs, retaining the shipped filenames/node IDs.
YINGXU_WORKFLOW_DIR=
# Exact external origins, comma separated, only if using a reverse proxy.
YINGXU_ALLOWED_ORIGINS=
# Account-enabled deployments use sessions, not shared Basic credentials.
# First administrator credentials: private/admin-bootstrap.json (never publish).
# Configure real payment merchants only as described in docs/payment-configuration.md.
