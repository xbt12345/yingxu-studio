# Leave blank to inspect the UI and tool previews. Real generation uses your own ComfyUI.
CHENYU_CARD_URL=
HOST=127.0.0.1
PORT=8770
# Optional: use an absolute path to move persistent uploads, outputs and SQLite.
YINGXU_DATA_DIR=
# Optional: use your own API graphs, retaining the shipped filenames/node IDs.
YINGXU_WORKFLOW_DIR=
# Exact external origins, comma separated, only if using a reverse proxy.
YINGXU_ALLOWED_ORIGINS=
# The studio now uses account sessions, not the former shared Basic credentials.
# First administrator credentials: private/admin-bootstrap.json (never publish).
# Configure real payment merchants only as described in docs/payment-configuration.md.
