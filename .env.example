# Leave blank for a free, offline demo. Real generation uses your own ComfyUI.
CHENYU_CARD_URL=
HOST=127.0.0.1
PORT=8770
# Optional: use an absolute path to move persistent uploads, outputs and SQLite.
YINGXU_DATA_DIR=
# Optional: use your own API graphs, retaining the shipped filenames/node IDs.
YINGXU_WORKFLOW_DIR=
# Exact external origins, comma separated, only if using a reverse proxy.
YINGXU_ALLOWED_ORIGINS=
# Public deployment: set a random password of at least 16 characters.
# Railway refuses to serve the studio until this password is configured.
# These credentials protect one shared studio, not separate user accounts.
YINGXU_ACCESS_USERNAME=yingxu
YINGXU_ACCESS_PASSWORD=
